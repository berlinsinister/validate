{
  "config": [
    {
      "label": "config-1",
      "inputs": [
        {
          "uid": "INPUT_0001",
          "controlElement": "input",
          "quasarComponent": "q-input",
          "isVisible": "checkbox === true",
          "fieldName": "fullName",
          "rules": "required|min:3|max:30|alpha",
          "model": "",
          "errorMessage": {
            "required": "first name is required",
            "min": "first name must be at least 3 characters length",
            "max": "first name must be at most 30 characters long",
            "alpha": "only letters [A-Z][a-z] allowed"
          },
          "title": "Lets get to know you",
          "subtitle": "Enter your first name using [A-Z][a-z] format only",
          "label": "first name"
        },
        {
          "uid": "DROPDOWN_0001",
          "controlElement": "dropdown",
          "quasarComponent": "q-select",
          "options": ["un", "dos", "tres", "cuatro", "cinco"],
          "isVisible": "radio === a",
          "fieldName": "dropdown",
          "rules": "required",
          "model": "",
          "errorMessage": {
            "required": "select any number"
          },
          "title": "Spanish numbers",
          "subtitle": "Learn to count in spanish up to five",
          "label": "numbers"
        },
        {
          "uid": "RADIO_0001",
          "controlElement": "radio",
          "quasarComponent": "q-option-group",
          "options": [
            { "label": "a", "value": "a" },
            { "label": "b", "value": "b" },
            { "label": "c", "value": "c" }
          ],
          "isVisible": true,
          "fieldName": "radio",
          "rules": "required",
          "model": "",
          "errorMessage": {
            "required": "selecting a radio is a must!"
          },
          "title": "Radios",
          "subtitle": "Selecting 'a' will show a dropdown. Selecting 'b' will show a checkbox. Selecting 'c' doesn't add any input field",
          "label": ""
        },
        {
          "uid": "CHECKBOX_0001",
          "controlElement": "checkbox",
          "quasarComponent": "q-checkbox",
          "isVisible": "radio === b",
          "fieldName": "checkbox",
          "rules": "required",
          "model": false,
          "errorMessage": {
            "required": "you must tick the checkbox"
          },
          "title": "Checkbox",
          "subtitle": "Ticking this will make a first name input field appear!",
          "label": "for first name input"
        }
      ]
    },
    {
      "label": "config-2",
      "inputs": [
        {
          "uid": "DROPDOWN_0002",
          "controlElement": "dropdown",
          "quasarComponent": "q-select",
          "options": ["languages", "sports", "encryption"],
          "isVisible": true,
          "fieldName": "dropdownTwo",
          "rules": "required",
          "model": "",
          "errorMessage": {
            "required": "you must select a hobby"
          },
          "title": "Hobby",
          "subtitle": "Select one of the available options (languages, sports or encryption)",
          "label": "hobby"
        },
        {
          "uid": "DROPDOWN_0003",
          "controlElement": "dropdown",
          "quasarComponent": "q-select",
          "options": ["spanish", "japanese", "finnish"],
          "isVisible": "dropdownTwo === languages",
          "fieldName": "dropdownThree",
          "rules": "required",
          "model": "",
          "errorMessage": {
            "required": "you must select a language"
          },
          "title": "Languages",
          "subtitle": "Select a language you are interested in",
          "label": "languages"
        },
        {
          "uid": "INPUT_0002",
          "controlElement": "input",
          "quasarComponent": "q-input",
          "isVisible": "dropdownTwo === encryption",
          "fieldName": "password",
          "rules": "required|min:3|password",
          "model": "",
          "errorMessage": {
            "required": "password is required",
            "min": "password cannot be shorter than 3 characters",
            "password": "password should have at least 1 uppercase letter, 1 lowercase letter, 1 number and 1 special character"
          },
          "title": "Password",
          "subtitle": "Password must contain uppercase and lowercase letters [A-Z][a-z] as well as numbers and special characters (e.g. %$^#*)",
          "label": "password"
        }
      ]
    }
  ]
}
